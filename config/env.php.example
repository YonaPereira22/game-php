<?php
// config/env.php.example — Ejemplo de variables de entorno PARA DOCUMENTACIÓN.
// Copia este archivo a `config/env.php` y rellena con valores reales en tu entorno.
// NO comitees `config/env.php` con credenciales reales.

// Variables de base de datos
putenv('DB_HOST=localhost');
putenv('DB_NAME=game');
putenv('DB_USER=root');
putenv('DB_PASS=');

// Variables de la aplicación
putenv('UPLOAD_TYPES=both');   // 'repo' | 'site' | 'both'
putenv('APP_VERSION=1.2');

// Nota: en producción es preferible definir estas variables en el panel/secret store del hosting.
